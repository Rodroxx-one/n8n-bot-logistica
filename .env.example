# Variables de entorno requeridas
# Copia este archivo como .env y completa los valores

# Telegram Bot (obtener con @BotFather en Telegram)
TELEGRAM_TOKEN=TU_TOKEN_DE_TELEGRAM

# Google Gemini API (obtener en https://aistudio.google.com → API Keys → GRATIS)
GEMINI_API_KEY=TU_API_KEY_DE_GEMINI

# Google Sheets (ID del spreadsheet — es la parte larga en la URL de tu hoja)
# Ejemplo: https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
SPREADSHEET_ID=TU_ID_DEL_SPREADSHEET

# Puerto
PORT=3000

# Google Service Account (pega el contenido del credentials.json en UNA SOLA LÍNEA)
# Obtener en: Google Cloud Console → IAM → Cuentas de servicio → Crear clave JSON
# Pegar el JSON completo minificado (sin saltos de línea extras)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}
