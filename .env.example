# Variables de entorno requeridas
# Copia este archivo como .env y completa los valores

# ── Telegram ─────────────────────────────────────────────────────────────────
# Obtener con @BotFather en Telegram
TELEGRAM_TOKEN=TU_TOKEN_DE_TELEGRAM

# ── Google Gemini API ─────────────────────────────────────────────────────────
# Obtener en https://aistudio.google.com → API Keys (GRATIS)
GEMINI_API_KEY=TU_API_KEY_DE_GEMINI
# Modelo o versión de Gemini a usar (por defecto gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ── Google Sheets ─────────────────────────────────────────────────────────────
# ID del spreadsheet — parte larga en la URL de tu hoja
# Ejemplo: https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
SPREADSHEET_ID=TU_ID_DEL_SPREADSHEET

# ── Google Service Account (para Sheets) ─────────────────────────────────────
# Pega el JSON completo del credentials.json en UNA SOLA LÍNEA
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}

# ── Google Drive ──────────────────────────────────────────────────────────────
# Activa la subida de fotos a Drive (true/false)
GOOGLE_DRIVE_ENABLED=true

# Nombre de la carpeta raíz en Drive (se crea automáticamente si no existe)
GOOGLE_DRIVE_ROOT_NAME=Logística Bot

# (Opcional) ID de carpeta raíz existente en Drive de la empresa
# Si lo defines, el bot sube directamente ahí sin buscarlo por nombre
# Para obtenerlo: abre la carpeta en Drive → copia el ID del final de la URL
GOOGLE_DRIVE_FOLDER_ID=

# ── Puerto ────────────────────────────────────────────────────────────────────
PORT=3000
