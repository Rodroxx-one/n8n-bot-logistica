{
  "name": "bot-logistica",
  "version": "2.0.0",
  "description": "Bot de Telegram para escaneo de etiquetas de rollos de tela con Gemini Vision y Google Sheets",
  "main": "server.js",
  "scripts": {
    "start"   : "node server.js",
    "pm2:start"  : "pm2 start ecosystem.config.js",
